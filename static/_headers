/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org https://basemap.nationalmap.gov; font-src 'self'; connect-src 'self' https://api.zqmlabs.com https://tile.openstreetmap.org https://basemap.nationalmap.gov; frame-src 'self'; frame-ancestors 'self' https://mischief.zqmlabs.com; base-uri 'self'; form-action 'self'
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()

# HTML: short cache with revalidation (was the Pages default max-age=0).
# /*.html covers directly-linked .html files; /*/ covers directory URLs;
# / covers the front page.
# NOTE: Cloudflare joins a header set by two matching rules, so a narrower
# rule that sets Cache-Control must detach it first ("! Cache-Control").
# A detach only removes what earlier rules added, so narrower rules go
# after broader ones.
/*.html
  Cache-Control: public, max-age=300, must-revalidate
/*/
  Cache-Control: public, max-age=300, must-revalidate
/
  Cache-Control: public, max-age=300, must-revalidate

# Long-cache the immutable assets
/css/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable
/games/hunt-for-wisps/play/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Sample data: cache like other static assets, revalidated via ETag
# (If-None-Match returns 304 — verified live 2026-11-19).
/computing/demonstrators/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, must-revalidate

# GeoPackage MIME type (Pages serves .gpkg as application/octet-stream)
/computing/demonstrators/parcel-screening/parcel_screening.gpkg
  Content-Type: application/geopackage+sqlite3
